      "checkConstraints": {
        "activity_epochs_status_check": {
          "name": "activity_epochs_status_check",
          "value": "\"activity_epochs\".\"status\" IN ('syncing', 'finalized', 'failed')"
        },
        "activity_epochs_counts_check": {
          "name": "activity_epochs_counts_check",
          "value": "(\"activity_epochs\".\"expected_elected_count\" IS NULL OR \"activity_epochs\".\"expected_elected_count\" >= 0)\n      AND (\"activity_epochs\".\"stored_elected_count\" IS NULL OR \"activity_epochs\".\"stored_elected_count\" >= 0)\n      AND \"activity_epochs\".\"attempt_count\" >= 0"
        },
        "activity_epochs_finalized_check": {
          "name": "activity_epochs_finalized_check",
          "value": "\"activity_epochs\".\"status\" != 'finalized' OR (\n      \"activity_epochs\".\"expected_elected_count\" IS NOT NULL\n      AND \"activity_epochs\".\"stored_elected_count\" IS NOT NULL\n      AND \"activity_epochs\".\"expected_elected_count\" = \"activity_epochs\".\"stored_elected_count\"\n      AND \"activity_epochs\".\"elected_set_hash\" IS NOT NULL\n      AND length(trim(\"activity_epochs\".\"elected_set_hash\", ' ' || char(9) || char(10) || char(13))) > 0\n      AND length(trim(\"activity_epochs\".\"started_at\", ' ' || char(9) || char(10) || char(13))) > 0\n      AND \"activity_epochs\".\"finalized_at\" IS NOT NULL\n      AND length(trim(\"activity_epochs\".\"finalized_at\", ' ' || char(9) || char(10) || char(13))) > 0\n      AND \"activity_epochs\".\"last_error\" IS NULL\n    )"
        }
      }
